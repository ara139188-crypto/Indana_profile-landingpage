    <style>
        /* Custom Underwater Scrollbar */
        ::-webkit-scrollbar {
            width: 10px;
        }
        ::-webkit-scrollbar-track {
            background: #020b18;
        }
        ::-webkit-scrollbar-thumb {
            background: #0d4b75;
            border-radius: 6px;
            border: 2px solid #020b18;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #00f2fe;
        }

        /* Glassmorphism Aquatic Panels */
        .glass-panel {
            background: rgba(10, 35, 66, 0.55);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(0, 242, 254, 0.2);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.45);
        }

        .glass-card {
            background: rgba(15, 50, 85, 0.4);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
            transform: translateY(-8px) scale(1.01);
            border-color: rgba(0, 242, 254, 0.6);
            box-shadow: 0 16px 35px rgba(0, 242, 254, 0.22);
        }

        /* Bioluminescent Glow Text and Elements */
        .text-glow {
            text-shadow: 0 0 15px rgba(0, 242, 254, 0.7), 0 0 30px rgba(0, 242, 254, 0.4);
        }

        .text-glow-coral {
            text-shadow: 0 0 15px rgba(255, 117, 140, 0.7);
        }

        .box-glow {
            box-shadow: 0 0 30px rgba(0, 242, 254, 0.25);
        }

        /* Light Rays Effect */
        .light-rays {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle at 50% -20%, rgba(0, 242, 254, 0.18) 0%, transparent 75%),
                        linear-gradient(180deg, rgba(2, 11, 24, 0) 0%, #020b18 100%);
            pointer-events: none;
            z-index: 1;
        }

        /* Animated Seaweeds */
        @keyframes sway {
            0%, 100% { transform: rotate(-6deg); }
            50% { transform: rotate(6deg); }
        }

        .seaweed-1 {
            animation: sway 5s infinite ease-in-out;
            transform-origin: bottom center;
        }

        .seaweed-2 {
            animation: sway 7s infinite ease-in-out 1s;
            transform-origin: bottom center;
        }

        /* Pulse wave animation */
        @keyframes wavePulse {
            0% { transform: scale(0.98); opacity: 0.8; }
            50% { transform: scale(1.02); opacity: 1; }
            100% { transform: scale(0.98); opacity: 0.8; }
        }

        .pulse-aquatic {
            animation: wavePulse 4s infinite ease-in-out;
        }

        /* Floating Jellyfish animation */
        @keyframes floatJelly {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-20px) rotate(4deg); }
        }

        .floating-jelly {
            animation: floatJelly 6s ease-in-out infinite;
        }

        /* Shimmer effect for buttons */
        @keyframes shimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }

        .btn-shimmer {
            background: linear-gradient(90deg, #00f2fe 0%, #4facfe 50%, #00f2fe 100%);
            background-size: 200% 100%;
            animation: shimmer 3s infinite linear;
        }

        canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 0;
        }
    </style>
</head>
